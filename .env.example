# Copy to .env and fill in a real key from https://platform.composio.dev
# Comma separated -> round-robin rotation (1,2,3,1,2,3...)
COMPOSIO_API_KEY=ak_key_one,ak_key_two,ak_key_three
COMPOSIO_RETRY_ON_KEY_FAILURE=true
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_USER_ID=default
COMPOSIO_TIMEOUT=90
HOST=0.0.0.0
PORT=8000
RELOAD=false
MAX_BATCH_SIZE=50
MAX_BATCH_CONCURRENCY=8
COMPOSIO_ALIASES=maps=COMPOSIO_SEARCH_GOOGLE_MAPS_SEARCH
GOOGLE_MAPS_DEFAULT_ZOOM=13
# BRIDGE_API_TOKEN=

# --- Per-key rate limit (sliding window cooldown, enforced by the bridge) ---
# Each key may make RATE_LIMIT_PER_KEY_PER_MINUTE calls per RATE_LIMIT_WINDOW_SECONDS.
# A key at its limit is put into cooldown and skipped until a slot frees up;
# only when ALL keys are cooling down does a request wait
# (up to RATE_LIMIT_MAX_WAIT_SECONDS, then 429/503). 0 = unlimited.
RATE_LIMIT_PER_KEY_PER_MINUTE=2000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_WAIT_SECONDS=65

# --- Batch processing (maps-batch CLI / Streamlit UI) ---
BRIDGE_URL=http://127.0.0.1:8000
PROCESSOR_BATCH_SIZE=50
PROCESSOR_CONCURRENCY=8
PROCESSOR_MAX_RETRIES=4
PROCESSOR_TIMEOUT=120
# Response mode for every search:
#   full = every field returned by the endpoint is written back as a maps_* column
#   slim = compact place payload (fewer columns, smaller file)
PROCESSOR_SHAPE=full
# Separator used when several columns are selected for the query
# (values of the selected columns are appended into one query). Default: a space.
QUERY_JOINER=

# --- Temp files (uploaded + processed) ---
# Where the UI stores job files. Empty/unset = <system tmp>/composio_bridge
TEMP_DIR=
# Files older than this are erased by the background sweeper.
TEMP_FILE_TTL_MINUTES=60
TEMP_CLEANUP_INTERVAL_SECONDS=300

# --- Streamlit UI ---
UI_HOST=0.0.0.0
UI_PORT=8501
